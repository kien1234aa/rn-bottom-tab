    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.29",
    "@types/react-native": "^0.72.8",
    "react": "^18.0.0",
    "react-native": "^0.72.0",
    "react-native-svg": "^15.15.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
