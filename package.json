{
  "name": "@kien0g/rn-bottom-tab",
  "version": "1.0.0",
  "description": "A customizable bottom tab bar component for React Native",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
